    "fan_xuanji_story2": {
      "label": "突破的感受·起",
      "url": "https://patchwiki.biligame.com/images/ys/0/06/61j5wxtktcgjbwsd6xq91nbbf8gt5zq.mp3",
      "original": "audio/nicole/originals/source-04.mp3",
      "bytes": 88801,
      "original_sha256": "5c876706936747efcb2c964fab2465511b70b1b0a260466dadfb1b5059b3d472",
      "output": "audio/nicole/skill/fan_xuanji_story2.mp3",
      "output_bytes": 117020,
      "sha256": "808ad8c84b01749ed7148616fbe0c08d868e105a557c5040e52908cfad4ea3af",
      "trim_seconds": null,
      "text": "「众人顿时慌了神，他们看向尼可的眼神充满不可思议：『尼可，你在做什么？你打晕艾莉丝做什么？』…」",
      "gain_db": -1.54,
      "measurement": {
        "lufs": -16.12,
        "true_peak_dbtp": -1.07,
        "mean_dbfs": -18.2,
        "peak_dbfs": -1.1
      },
      "review": "silence-boundary analysis; not human-listened"
    },
    "fan_xuanji_story3": {
      "label": "突破的感受·承",
      "url": "https://patchwiki.biligame.com/images/ys/3/31/r1zf181tr7ld3h4duyal14y8rtqrdsn.mp3",
      "original": "audio/nicole/originals/source-05.mp3",
      "bytes": 97628,
      "original_sha256": "3c28a18b7704005769da09262f06e2c6c50f4edf904a159c522c80e34192e7b3",
      "output": "audio/nicole/skill/fan_xuanji_story3.mp3",
      "output_bytes": 131228,
      "sha256": "9b94649f608eaa0200b787e109c0dfd21a42c741d50aba2377fc6f5121b76375",
      "trim_seconds": null,
      "text": "「尼可不慌不忙，伸出一根手指：『艾莉丝已经力量耗尽了。留在战场也只是累赘。带她下去休息吧。』」",
      "gain_db": -1.44,
      "measurement": {
        "lufs": -18.54,
        "true_peak_dbtp": -1.43,
        "mean_dbfs": -20.0,
        "peak_dbfs": -1.5
      },
      "review": "silence-boundary analysis; not human-listened"
    },
    "fan_xuanji_story4": {
      "label": "突破的感受·转",
      "url": "https://patchwiki.biligame.com/images/ys/5/5a/owsz432u9zbshgf9cqck493n61uomvw.mp3",
      "original": "audio/nicole/originals/source-06.mp3",
      "bytes": 81551,
      "original_sha256": "153b48615fcce5db222f113788d8bf5845199886bbb4e987f75c0551f5d0d2c3",
      "output": "audio/nicole/skill/fan_xuanji_story4.mp3",
      "output_bytes": 111548,
      "sha256": "3020254b78e224e10ee3f423b3e0898a316743f69348149dc8596fe273c296ab",
      "trim_seconds": null,
      "text": "「『没有了艾莉丝，我们怎么匹敌莱茵多特？』众人对尼可的建议不屑一顾。只见尼可走上前去…」",
      "gain_db": -1.52,
      "measurement": {
        "lufs": -19.21,
        "true_peak_dbtp": -1.58,
        "mean_dbfs": -20.1,
        "peak_dbfs": -1.7

    },
    {
      "entry": "元素战技·其二",
      "text": "别说谎。",
      "url": "https://patchwiki.biligame.com/images/ys/4/40/c7cawfmypbbw1g3x93scacd8i0ekwn7.mp3",
      "bytes": 11789,
      "original": "audio/nefer/originals/fan_huanwu2.mp3",

      "output_bytes": 14031,
      "sha256": "e48de571965717ec7be0decce1c06ff4cc0498b515e6a5d7da3bda3e2b82a700"
    },
    {
      "entry": "元素爆发·其一",
      "text": "欺谎的唤声。",
      "url": "https://patchwiki.biligame.com/images/ys/3/37/iwa6marj39gmyqt6vq8e5g9ugc484ct.mp3",
      "bytes": 17595,
      "original": "audio/nefer/originals/fan_miwen1.mp3",

      "trim": null,
      "output_bytes": 17530,
      "sha256": "3549e0910bfba5f1d9b1e10704317a3495a683e196f4345c2901acaeaebfe45d"
    },
    {
      "entry": "元素爆发·其三",
      "text": "如是观想，真谜具解。",
      "url": "https://patchwiki.biligame.com/images/ys/9/9d/70b4gt2wosbv9sceuy0dhk5ds0avrqo.mp3",
      "bytes": 34547,
      "original": "audio/nefer/originals/fan_miwen3.mp3",

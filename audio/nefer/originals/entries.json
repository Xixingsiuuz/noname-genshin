      "sha256": "7878ba4a637bae6974b52ecc722ee964a9cf7c5ead9f7f7653afb9cb8a072940"
    },
    {
      "entry": "元素战技·其三",
      "text": "真言如影。",
      "url": "https://patchwiki.biligame.com/images/ys/a/ab/tmeh1cjimbcvv72bxrg8dxuy4iesbjs.mp3",
      "bytes": 14031,
      "original": "audio/nefer/originals/fan_huanwu3.mp3",

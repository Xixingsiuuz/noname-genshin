      "trim": null,
      "output_bytes": 17595,
      "sha256": "497da5dcba33ca5eaed7e84aa33c3fb48aaa2486ef4d93c386b8cc627fae754e"
    },
    {
      "entry": "元素爆发·其二",
      "text": "索见诸心。",
      "url": "https://patchwiki.biligame.com/images/ys/e/e6/lbd0jwyv8yzigm3du1r202sjcwd7gie.mp3",
      "bytes": 17530,
      "original": "audio/nefer/originals/fan_miwen2.mp3",

      "trim": null,
      "output_bytes": 34547,
      "sha256": "aa949fb69239b761f5b56c4b358e55a8e9bcac9de37a6e7c4ab9033ef29bd5c8"
    },
    {
      "entry": "倒下·其一",
      "text": "黄沙…追上我了…",
      "url": "https://patchwiki.biligame.com/images/ys/f/f2/etc2ztaaues5k9fbtgp19l94dh44mid.mp3",
      "bytes": 37953,
      "original": "audio/nefer/originals/fan_nefer1.mp3",

    },
    {
      "entry": "倒下·其二",
      "text": "无解的…谜题…",
      "url": "https://patchwiki.biligame.com/images/ys/8/8c/27rnvev1977wiug28r7sh938vg7lizq.mp3",
      "bytes": 33151,
      "original": "audio/nefer/originals/fan_nefer2.mp3",

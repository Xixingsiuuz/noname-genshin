    },
    "fan_yuxiu2": {
      "label": "闲聊·裁缝刀",
      "text": "谁说裁衣服一定要用剪刀？那些死板的规矩由它去吧，我喜欢自己用着顺手的刀具。",
      "url": "https://patchwiki.biligame.com/images/ys/8/8a/k280oa88d8idt3m7k86cjkrb88o9w96.mp3",
      "bytes": 215318,
      "original": "audio/chiori/originals/fan_yuxiu2.mp3",
      "output": "audio/chiori/skill/fan_yuxiu2.mp3",
      "output_bytes": 215318,
      "trim_seconds": null
    },
    "fan_yuxiu3": {
      "label": "闲聊·模特",
      "text": "真要站着不动的话，干脆来当我的模特吧。给你设计款好看的衣服。",
